global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    site: @SITE_ID@

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:9090']
        labels:
          layer: host

  - job_name: node
    static_configs:
      - targets: ['127.0.0.1:9100']
        labels:
          layer: host

  - job_name: libvirt
    static_configs:
      - targets: ['127.0.0.1:9177']
        labels:
          layer: host

  - job_name: alloy
    static_configs:
      - targets: ['127.0.0.1:12345']
        labels:
          layer: host

  - job_name: blackbox_icmp
    metrics_path: /probe
    params:
      module: [icmp]
    file_sd_configs:
      - files:
          - /opt/jammy-obs-agent/etc/probes.yml
    relabel_configs:
      - source_labels: [target_site]
        regex: @SITE_ID@
        action: drop
      - target_label: vantage
        replacement: @SITE_ID@
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115

  - job_name: blackbox_ssh
    metrics_path: /probe
    params:
      module: [tcp_connect]
    file_sd_configs:
      - files:
          - /opt/jammy-obs-agent/etc/probes.yml
    relabel_configs:
      - source_labels: [target_site]
        regex: @SITE_ID@
        action: drop
      - target_label: vantage
        replacement: @SITE_ID@
      - source_labels: [__address__]
        regex: (.*)
        replacement: ${1}:22
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115

remote_write:
  - url: http://@OBS_HOST@:9090/api/v1/write
    queue_config:
      capacity: 10000
      max_shards: 10
      max_samples_per_send: 2000
