# managed-by: jammy-obs-agent
[Unit]
Description=Prometheus Blackbox Exporter for Site Host
After=network.target

[Service]
Type=simple
User=obsagent
Group=obsagent
ExecStart=/opt/jammy-obs-agent/bin/blackbox_exporter \
  --config.file=/opt/jammy-obs-agent/etc/blackbox.yml \
  --web.listen-address=127.0.0.1:9115
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/jammy-obs-agent
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
