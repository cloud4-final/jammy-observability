# managed-by: jammy-obs-agent
[Unit]
Description=Prometheus Site Agent (Local 48h Retention + Remote Write)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obsagent
Group=obsagent
ExecStart=/opt/jammy-obs-agent/bin/prometheus \
  --config.file=/opt/jammy-obs-agent/etc/prometheus.yml \
  --web.listen-address=127.0.0.1:9090 \
  --storage.tsdb.path=/var/lib/jammy-obs-agent/prometheus \
  --storage.tsdb.retention.time=48h \
  --storage.tsdb.retention.size=5GB
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/jammy-obs-agent

[Install]
WantedBy=multi-user.target
