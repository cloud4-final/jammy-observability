  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "HTTP Traffic & Error Rates",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (endpoint, method) (rate(http_requests_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{endpoint}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate (RPS by Endpoint)",
      "type": "timeseries",
      "description": "**collector 초당 요청 수**\n\n- 갑자기 0 → collector 중단 또는 입구 경로 문제"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{site=~\"$site\",status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "5xx Error Rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx Error Rate",
      "type": "timeseries",
      "description": "**5xx 오류 비율**\n\n- 정상: 0에 가까움\n- 503 증가 → 대부분 DB 연결 문제, `jammy-db` 확인"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 101,
      "title": "Latency & Database Query Duration",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{site=~\"$site\"}[$__rate_interval])))",
          "legendFormat": "{{endpoint}} (p50)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{site=~\"$site\"}[$__rate_interval])))",
          "legendFormat": "{{endpoint}} (p95)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{site=~\"$site\"}[$__rate_interval])))",
          "legendFormat": "{{endpoint}} (p99)",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "HTTP Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "description": "**요청 처리 시간 (p50 / p95 / p99)**\n\n- p99만 튀면 일부 요청만 느림\n- DB lock, 복제 지연, Wi-Fi 지터 의심"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(db_query_duration_seconds_bucket{site=~\"$site\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} (p95)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Database Query Duration p95 by Operation",
      "type": "timeseries",
      "description": "**DB 쿼리 시간 p95**\n\n- HTTP 지연과 같이 늘면 → DB가 원인\n- 혼자 그대로면 → 앱·네트워크 쪽"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 102,
      "title": "Ingestion Pipeline & Event Collection",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status, region) (rate(mobility_events_collected_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "{{status}} [{{region}}]",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Mobility Events Ingestion Rate by Status & Region",
      "type": "timeseries",
      "description": "**이벤트 접수 결과**\n\n- accepted: 신규 저장\n- duplicate: 재전송된 이벤트\n- rejected: 잘못된 region (400)"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 103,
      "title": "Telemetry Logs & Distributed Traces",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 25
      },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=~\".*collector.*\", site=~\"$site\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Collector Service Logs (Loki)",
      "type": "logs",
      "description": "**collector 로그**\n\n- 오류 시각 전후 확인\n- `trace_id`로 Tempo와 연결"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "id": 7,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "search",
          "refId": "A",
          "serviceName": "mobility-collector"
        }
      ],
      "title": "Collector Distributed Traces (Tempo)",
      "type": "traces",
      "description": "**요청 추적 (Tempo)**\n\n- 느린 요청을 열어 오래 걸린 구간 확인"
    }
  ],
  "refresh": "10s",
