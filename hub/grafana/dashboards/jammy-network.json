    {
      "id": 4,
      "title": "RTT from $vantage",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_icmp_duration_seconds{phase=\"rtt\",vantage=~\"$vantage\"}",
          "legendFormat": "→ {{target_site}}"
        }
      ],
      "repeat": "vantage",
      "repeatDirection": "h",
      "maxPerRow": 4,
      "description": "**거점 간 왕복 시간 (RTT)**\n\n- 평소: 5~50ms, 순간 최대 약 200ms\n- 75ms 근처에서 평평 → relay 경유 중\n- (2026-11-08 실측)"
    },
